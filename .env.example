# ── Database ──────────────────────────────────────────────────────────────────
PG_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://sk_app:changeme@localhost:5432/sahulatkar

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@localhost:6379/0

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ── KYC / Identity ────────────────────────────────────────────────────────────
NADRA_API_KEY=
NADRA_API_URL=https://api.nadra.gov.pk/v1
SHUFTI_CLIENT_ID=
SHUFTI_SECRET_KEY=

# ── Payments ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
SAFEPAY_API_KEY=
SAFEPAY_BASE_URL=https://sandbox.safepay.pk
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_WEBHOOK_SECRET=
RAAST_API_KEY=
RAAST_API_SECRET=
RAAST_MERCHANT_IBAN=
RAAST_BASE_URL=https://sandbox.raast-gateway.pk/api/v1

# ── Delivery / Tracking ───────────────────────────────────────────────────────
# Read by notification-service (src/config.py, src/api/v1/webhooks.py)
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=

# ── Product Extraction ────────────────────────────────────────────────────────
# All read by product-service (src/config.py)
OPENAI_API_KEY=
BRIGHTDATA_PROXY_URL=
RYE_API_KEY=
VIOLET_API_KEY=
GROQ_API_KEY=
# CAPTCHA_PROVIDER selects the solver implementation used by form_filler.py;
# valid values: two_captcha | capsolver | none (default "none" = disabled).
CAPTCHA_PROVIDER=none
CAPTCHA_API_KEY=

# ── AWS / Storage ─────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
# Standard AWS SDK creds picked up by boto3's default credential chain — used
# implicitly by product-service's S3Service and by aioboto3 clients wherever no
# explicit key/secret is passed (config.py in product-service/ledger-service).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Gateway contract/KYC document storage. Read by apps/gateway/src/config.py and
# consumed via packages/shared-python/sk_shared/storage.py's get_storage_client().
# NOTE: contracts.py and kyc.py both call get_storage_client(settings), so today
# there is a SINGLE shared bucket/credential set for both contract PDFs and KYC
# documents — the code has no separate "contracts bucket" vs "KYC bucket"
# concept. If that split is wanted later, sk_shared/storage.py and gateway's
# config.py need a second bucket setting added before a second env var here
# would do anything. Leaving S3_BUCKET/S3_ACCESS_KEY unset makes gateway fall
# back to local-disk storage (CONTRACT_STORAGE_DIR) instead of erroring.
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=

# product-service: screenshot storage + cached product images
# (src/config.py, src/services/s3_service.py)
S3_BUCKET_SCREENSHOTS=sk-screenshots-dev
PRODUCT_IMAGE_BUCKET=sk-product-images-dev
# SSE-KMS key ARN used when product-service uploads to the buckets above.
AWS_KMS_KEY_ARN=

ECR_REGISTRY=

# ── Feature Flags ─────────────────────────────────────────────────────────────
FF_JAZZCASH_ENABLED=true
FF_RAAST_ENABLED=false
FF_LITHIC_VCN=false

# ── Notifications (all read by notification-service unless noted) ────────────
# Email — SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@sahulatkar.pk
SENDGRID_FROM_NAME=SahulatKar
SENDGRID_WEBHOOK_SECRET=

# SMS — Jazz (primary), Twilio (fallback, selected via SMS_FALLBACK_PROVIDER)
JAZZ_SMS_API_URL=https://sms.jazz.com.pk/api/send
JAZZ_SMS_USERNAME=
JAZZ_SMS_PASSWORD=
JAZZ_SMS_SENDER_ID=SahulatKar
JAZZ_SMS_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# WhatsApp — Jazz Business API (primary), Twilio (fallback)
JAZZ_WHATSAPP_API_URL=https://waba.jazz.com.pk/v1/messages
JAZZ_WHATSAPP_API_KEY=
JAZZ_WHATSAPP_FROM_NUMBER=
JAZZ_WHATSAPP_WEBHOOK_SECRET=
TWILIO_WHATSAPP_FROM=

# Push — Firebase FCM v1
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# ── Shariah Compliance ────────────────────────────────────────────────────────
CHARITY_ORGANIZATION_NAME=Al-Khidmat Foundation
